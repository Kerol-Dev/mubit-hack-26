MUBIT_API_KEY=
MUBIT_MODEL=claude-haiku-4-5
# Only enable for fictional portal requests: stores their input and output in
# Mubit Requests and makes them eligible for training. Evaluations stay excluded.
MUBIT_RECORD_DEMO_REQUESTS=false
PORT=4174

# Direct provider vs Mubit comparison (server only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COMPARISON_MODEL=claude-haiku-4-5

# Optional link to your own Mubit task. No account-specific link is shipped.
MUBIT_CONSOLE_URL=
# Show the dated hackathon-project snapshot only for that original project.
MUBIT_SHOW_DEMO_TRAINING_SNAPSHOT=false
